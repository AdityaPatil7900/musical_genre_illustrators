[Unit]
Description=Musical Genre Illustrator - Locally-executed product (Case Study 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=student-admin
WorkingDirectory=/home/student-admin/musical_genre_illustrators
EnvironmentFile=/home/student-admin/musical_genre_illustrators/deploy/.env
Environment=APP_MODE=local
Environment=PORT=8013
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/student-admin/musical_genre_illustrators/.venv/bin/python vm_app.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
