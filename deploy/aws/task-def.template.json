{
  "family": "genre-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "4096",
  "executionRoleArn": "__EXECUTION_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "genre-api",
      "image": "__IMAGE_URI__",
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_MODE", "value": "api" },
        { "name": "PORT", "value": "8080" }
      ],
      "secrets": [
        { "name": "HF_TOKEN", "valueFrom": "__HF_TOKEN_SECRET_ARN__" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/genre-api",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "genre-api",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
