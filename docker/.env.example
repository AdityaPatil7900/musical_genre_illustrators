# Copy to docker/.env and fill in real values before `docker compose up`.
# NEVER commit the real docker/.env -- it's covered by .gitignore.
#
# IMPORTANT: this VM is SHARED across every group in the class. Before you
# pick ports, claim an unused block on the class Google Sheet (rubric item
# 1c) and set the values below to match what you actually claimed -- the
# numbers here are just placeholders from this template.

HF_TOKEN=your_huggingface_token_here

# Host-side ports (left of the ":" in docker-compose.yml's port mappings).
# Everything right of the ":" is fixed (matches what's EXPOSEd in the image)
# and does not need to change.
API_APP_PORT=8012
API_METRICS_PORT=8002
API_NODE_EXPORTER_PORT=9102

LOCAL_APP_PORT=8013
LOCAL_METRICS_PORT=8003
LOCAL_NODE_EXPORTER_PORT=9103

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
